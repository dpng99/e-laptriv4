# ==============================================================================
# e-LKjIP JAMBIN - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk:
# 1. Salin file ini ke .env pada server production: cp .env.production.example .env
# 2. Generate APP_KEY unik baru: php artisan key:generate
# 3. Sesuaikan URL, kredensial DB production, dan domain session
# 4. Hapus atau pastikan KINERJA_BOOTSTRAP_PASSWORD tidak diset setelah seeding
# ==============================================================================

APP_NAME="e-LKjIP JAMBIN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://e-lkjip.kejaksaan.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Database (Gunakan akun DB dedicated dengan hak akses terbatas pada database e-LKjIP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elkjip_jambin_prod
DB_USERNAME=elkjip_prod_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT_DAN_ACAK

# Session Security (Wajib Enkripsi & Cookie Aman via HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kejaksaan.go.id"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Route Registrasi Akun Publik (Wajib false di production)
AUTH_REGISTRATION_ENABLED=false

# PENTING: JANGAN set KINERJA_BOOTSTRAP_PASSWORD di server production.
# Seeder otomatis menghasilkan password acak 32 karakter jika variabel ini tidak ada.
# KINERJA_BOOTSTRAP_PASSWORD=
